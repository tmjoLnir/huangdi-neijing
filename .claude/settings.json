{
  "permissions": {
    "allow": [
      "Bash(node scripts/build_subtitles.js:*)",
      "Bash(node scripts/check_caption_fit.js:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "mcp__higgsfield__balance",
      "mcp__higgsfield__models_explore",
      "mcp__higgsfield__generate_image",
      "mcp__higgsfield__generate_video",
      "mcp__higgsfield__generate_audio",
      "mcp__higgsfield__job_display",
      "mcp__higgsfield__reframe",
      "mcp__higgsfield__upscale_video",
      "mcp__higgsfield__media_upload",
      "mcp__higgsfield__media_confirm",
      "mcp__higgsfield__sandbox_exec"
    ],
    "deny": [
      "Bash(npm uninstall *)",
      "Bash(yarn add *)",
      "Bash(pip install *)",
      "Bash(rm *)",
      "Bash(rmdir *)"
    ],
    "ask": [
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(ssh *)",
      "Bash(scp *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
